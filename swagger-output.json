{
  "openapi": "3.0.0",
  "info": {
    "title": "API Soutenances IAI",
    "description": "API de collecte des frais de soutenance - Institut Africain d'Informatique",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:3000/"
    }
  ],
  "tags": [
    {
      "name": "Utilisateurs",
      "description": "Gestion des administrateurs"
    },
    {
      "name": "Paiements",
      "description": "Gestion des paiements Mobile Money"
    },
    {
      "name": "Photos",
      "description": "Upload de photos"
    }
  ],
  "paths": {
    "/": {
      "get": {
        "description": "",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/photos/upload": {
      "post": {
        "tags": [
          "Photos"
        ],
        "summary": "Uploader une photo et générer la carte de soutenance",
        "description": "Télécharge une photo (jpeg, jpg, png, webp - max 5 Mo) et les métadonnées de la soutenance, puis génère la carte (PDF rempli converti en PNG) selon la filière et le niveau du token de paiement.",
        "parameters": [
          {
            "name": "authorization",
            "in": "header",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Carte générée (apercu base64 + url)"
          },
          "400": {
            "description": "Photo manquante, format invalide ou champs manquants"
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Aucun modèle de carte pour cette filière/niveau"
          },
          "500": {
            "description": "Erreur lors du téléchargement"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": [
                  "photo",
                  "theme",
                  "jour",
                  "heure",
                  "salle",
                  "encadreurAcademique",
                  "encadreurProfessionnel"
                ],
                "properties": {
                  "photo": {
                    "type": "string",
                    "format": "binary",
                    "description": "Fichier image (jpeg, jpg, png, webp) - max 5 Mo"
                  },
                  "theme": {
                    "type": "string",
                    "description": "Thème de la soutenance"
                  },
                  "jour": {
                    "type": "string",
                    "description": "Date de la soutenance (ex: 12/08/2026)"
                  },
                  "heure": {
                    "type": "string",
                    "description": "Heure de la soutenance (ex: 10h30)"
                  },
                  "salle": {
                    "type": "string",
                    "description": "Salle où se déroule la soutenance"
                  },
                  "encadreurAcademique": {
                    "type": "string",
                    "description": "Encadreur academique"
                  },
                  "encadreurProfessionnel": {
                    "type": "string",
                    "description": "Encadreur professionnel"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/buy-it/": {
      "post": {
        "tags": [
          "Paiements"
        ],
        "summary": "Effectuer un paiement Mobile Money",
        "description": "Initie un paiement Mobile Money via Orange ou MTN et envoie un email de confirmation.",
        "responses": {
          "200": {
            "description": "Paiement réussi",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Paiement"
                }
              },
              "application/xml": {
                "schema": {
                  "$ref": "#/components/schemas/Paiement"
                }
              }
            }
          },
          "400": {
            "description": "Champs manquants"
          },
          "402": {
            "description": "Échec du paiement"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Paiement"
              }
            }
          }
        }
      },
      "get": {
        "tags": [
          "Paiements"
        ],
        "summary": "Lister tous les paiements",
        "description": "Retourne la liste des paiements avec pagination. Authentification requise.",
        "parameters": [
          {
            "name": "authorization",
            "in": "header",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Liste des paiements"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/buy-it/add": {
      "post": {
        "tags": [
          "Paiements"
        ],
        "summary": "Ajouter un paiement",
        "description": "Ajouter un paiement manuellement dans la base de données.",
        "parameters": [
          {
            "name": "authorization",
            "in": "header",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "201": {
            "description": "Paiement enregistré manuellement"
          },
          "400": {
            "description": "Bad Request"
          },
          "401": {
            "description": "Unauthorized"
          },
          "402": {
            "description": "Payment Required"
          },
          "403": {
            "description": "Forbidden"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Paiement"
              }
            }
          }
        }
      }
    },
    "/buy-it/get-paydata": {
      "get": {
        "tags": [
          "Paiements"
        ],
        "summary": "Récupérer les données du paiement",
        "description": "Retourne les données du paiement (nom, email, filière, classe) associées au token de paiement fourni.",
        "parameters": [
          {
            "name": "authorization",
            "in": "header",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Données du paiement"
          },
          "401": {
            "description": "Token invalide ou expiré"
          },
          "404": {
            "description": "Not Found"
          },
          "500": {
            "description": "Internal Server Error"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/buy-it/{id}": {
      "get": {
        "tags": [
          "Paiements"
        ],
        "summary": "Obtenir un paiement par ID",
        "description": "Retourne les détails d'un paiement spécifique.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "ID MongoDB du paiement"
          },
          {
            "name": "authorization",
            "in": "header",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Paiement trouvé"
          },
          "404": {
            "description": "Paiement introuvable"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      },
      "delete": {
        "tags": [
          "Paiements"
        ],
        "summary": "Supprimer un paiement (soft delete)",
        "description": "Marque un paiement comme supprimé (isActive: false) sans l'effacer de la base.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "ID MongoDB du paiement"
          },
          {
            "name": "authorization",
            "in": "header",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Paiement supprimé"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          },
          "404": {
            "description": "Paiement introuvable"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/buy-it/search/{field}": {
      "get": {
        "tags": [
          "Paiements"
        ],
        "summary": "Rechercher des paiements par champ",
        "description": "Recherche des paiements par nom, matricule, classe, filière ou niveau (insensible à la casse).",
        "parameters": [
          {
            "name": "field",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Champ de recherche (nom, matricule, classe, filiere, niveau)"
          },
          {
            "name": "authorization",
            "in": "header",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "value",
            "in": "query",
            "description": "Valeur à rechercher",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Résultats de la recherche"
          },
          "400": {
            "description": "Champ de recherche invalide"
          },
          "404": {
            "description": "Aucun paiement trouvé"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/utilisateurs/": {
      "post": {
        "tags": [
          "Utilisateurs"
        ],
        "summary": "Créer un compte administrateur",
        "description": "Inscrit un nouvel utilisateur avec nom, email, mot de passe et téléphone.",
        "parameters": [
          {
            "name": "authorization",
            "in": "header",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Utilisateur créé avec succès",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Utilisateur"
                }
              },
              "application/xml": {
                "schema": {
                  "$ref": "#/components/schemas/Utilisateur"
                }
              }
            }
          },
          "400": {
            "description": "Champs manquants"
          },
          "409": {
            "description": "Cet utilisateur existe déjà."
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Utilisateur"
              }
            }
          }
        }
      }
    },
    "/utilisateurs/signin": {
      "post": {
        "tags": [
          "Utilisateurs"
        ],
        "summary": "Connecter un administrateur",
        "description": "Authentifie un utilisateur avec email et mot de passe.",
        "responses": {
          "201": {
            "description": "Authentification réussie",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Utilisateur"
                }
              },
              "application/xml": {
                "schema": {
                  "$ref": "#/components/schemas/Utilisateur"
                }
              }
            }
          },
          "400": {
            "description": "Mot de passe incorrect"
          },
          "404": {
            "description": "Utilisateur introuvable"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SignInBody"
              }
            }
          }
        }
      }
    },
    "/utilisateurs/signout": {
      "post": {
        "tags": [
          "Utilisateurs"
        ],
        "summary": "Déconnecter un administrateur",
        "description": "Déconnecte l'utilisateur (le token est géré côté client).",
        "responses": {
          "200": {
            "description": "Déconnexion réussie"
          }
        }
      }
    },
    "/utilisateurs/get-session": {
      "get": {
        "tags": [
          "Utilisateurs"
        ],
        "summary": "Vérifier une session utilisateur",
        "description": "Vérifie la validité du token JWT et retourne les informations de session.",
        "parameters": [
          {
            "name": "authorization",
            "in": "header",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Session active"
          },
          "401": {
            "description": "Token manquant, invalide ou expiré"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "Utilisateur": {
        "type": "object",
        "properties": {
          "nom": {
            "type": "string",
            "example": "TINGUEU Shivano"
          },
          "email": {
            "type": "string",
            "example": "tingueushivano@example.com"
          },
          "password": {
            "type": "string",
            "example": "123456"
          },
          "phone": {
            "type": "string",
            "example": "6xxxxxxxx"
          }
        },
        "xml": {
          "name": "Utilisateur"
        }
      },
      "SignInBody": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "tingueushivano@example.com"
          },
          "password": {
            "type": "string",
            "example": "123456"
          }
        },
        "xml": {
          "name": "SignInBody"
        }
      },
      "Paiement": {
        "type": "object",
        "properties": {
          "nom": {
            "type": "string",
            "example": "TINGUEU Shivano"
          },
          "email": {
            "type": "string",
            "example": "tingueushivano@example.com"
          },
          "filiere": {
            "type": "string",
            "example": "Génie logiciel"
          },
          "niveau": {
            "type": "number",
            "example": 3
          },
          "classe": {
            "type": "string",
            "example": "GL3A"
          },
          "matricule": {
            "type": "string",
            "example": "IAI-2025-001"
          },
          "numero": {
            "type": "string",
            "example": "6xxxxxxxx"
          },
          "operateur": {
            "type": "string",
            "example": "ORANGE"
          }
        },
        "xml": {
          "name": "Paiement"
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Entrez votre token JWT (ex: Bearer <token>)"
      }
    }
  }
}